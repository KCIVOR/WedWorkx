# WedWorks 10-10-10: PRODUCTION .env template.
# Copy to .env on the server (never commit the real file) and fill in every value marked CHANGE.

APP_NAME="WedWorks 10-10-10"
APP_ENV=production
APP_KEY=                       # CHANGE: run `php artisan key:generate --force` once on the server
APP_DEBUG=false                # must stay false in production
APP_URL=https://CHANGE.example.com
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# Database (cPanel: MySQL Databases creates both the database and the user)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE_cpanelprefix_wedworks
DB_USERNAME=CHANGE_cpanelprefix_wedworks
DB_PASSWORD=CHANGE

# No queue worker and no Redis on shared hosting
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Mail (cPanel: Email Accounts, then "Connect Devices" shows the SMTP details)
MAIL_MAILER=smtp
MAIL_HOST=CHANGE.example.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=campaign@CHANGE.example.com
MAIL_PASSWORD=CHANGE
MAIL_FROM_ADDRESS="campaign@kasalangtagaytay.ph"
MAIL_FROM_NAME="Kasalang Tagaytay"

# HitPay LIVE (the sandbox key and salt do not work in production)
HITPAY_API_KEY=CHANGE
HITPAY_SALT=CHANGE
HITPAY_BASE_URL=https://api.hit-pay.com/v1

# Friendlier question wording (optional; off keeps the scripted questions)
AI_WORDING_ENABLED=false
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_MAX_TOKENS=150
AI_MAX_CALLS=12
AI_TIMEOUT=4

# Hermes agents on the Mac mini: a long random token, e.g. `php -r "echo bin2hex(random_bytes(32));"`
HERMES_API_TOKEN=CHANGE
HERMES_RATE_LIMIT=120

# Sign-up form submissions per minute per IP (a booth may share one Wi-Fi address)
REGISTER_RATE_LIMIT=30

# Dev mode simulates payments and progress. It is ignored in production, but keep it false.
DEV_MODE=false

# Optional tuning (defaults shown)
# CAMPAIGN_REMINDER_HOURS=2
# UPLOAD_MAX_KB=5120
# UPLOAD_MAX_LOGO=1
# UPLOAD_MAX_PHOTOS=10

# Admin area path (default "admin"). Pick something hard to guess. Create the admin with: php artisan admin:create you@example.com
ADMIN_PATH=admin
