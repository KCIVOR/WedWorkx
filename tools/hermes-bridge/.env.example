# Copy this file to ".env" (same folder) and fill it in. Never share the .env file: it holds the token.

# Where WedWorks runs. On this computer: http://localhost:8000
WEDWORKS_URL=http://localhost:8000

# The Hermes token from Admin > Settings > Hermes agents > Create a token
WEDWORKS_HERMES_TOKEN=

# The Hermes profile (agent) that talks to suppliers. Only this one is ever used. Example: wedworks-chat
HERMES_PROFILE=wedworks-chat

# Optional
# HERMES_EXE=C:\Users\YourName\AppData\Local\hermes\bin\hermes.exe
# POLL_SECONDS=1.5
# MAX_PARALLEL=3
# CALL_TIMEOUT=40
# SHOW_MESSAGES=0
