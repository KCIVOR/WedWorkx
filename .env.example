APP_NAME="WedWorks 10-10-10"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wedworks_chatbot
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="campaign@kasalangtagaytay.ph"
MAIL_FROM_NAME="Kasalang Tagaytay"


VITE_APP_NAME="${APP_NAME}"

# HitPay (sandbox first)
HITPAY_API_KEY=
HITPAY_SALT=
HITPAY_BASE_URL=

# AI wording (used from T9)
# Friendlier question wording. Off by default. Scripted questions are always the fallback.
AI_WORDING_ENABLED=false
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=
AI_MAX_TOKENS=150
AI_MAX_CALLS=12
AI_TIMEOUT=4

# Hermes agents API (used from T7)
HERMES_API_TOKEN=

# Dev mode: simulates the HitPay checkout, Hermes progress and the scheduler so the whole journey can be
# clicked through locally. Never active in production. See docs/DEV_MODE.md
DEV_MODE=false

# Admin area path and sign-in limits. Create an admin with: php artisan admin:create you@example.com
ADMIN_PATH=admin

# Who asks the chat questions: system (fixed questions) or hermes (the AI agent). Admin > Settings overrides these.
CHAT_MODE_REGISTRATION=system
CHAT_MODE_WEBSITE=system
